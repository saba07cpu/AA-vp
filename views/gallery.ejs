<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Fotogalerii</title>
</head>
<body>
    <h1>Fotogalerii</h1>
    <p><a href="/home">Tagasi avalehele</a></p>
    <hr>

    <% if (photos && photos.length > 0) { %>
        <% photos.forEach(photo => { %>
            <img src="/gallery/thumbs/<%= photo.filename %>" alt="<%= photo.alttext || 'Galeriipilt' %>">
        <% }); %>
    <% } else { %>
        <p>Pilte ei leitud.</p>
    <% } %>

</body>
</html>